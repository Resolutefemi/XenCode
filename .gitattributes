# Default: text files are stored exactly as committed (no automatic CRLF conversion) and are not converted on checkout.
# Fixes the recurring "LF will be replaced by CRLF" warning during commit.
* text=auto eol=lf

# Explicitly normalize text file types to LF (consistent across platforms)
*.kt     text eol=lf
*.kts    text eol=lf
*.java   text eol=lf
*.xml    text eol=lf
*.gradle text eol=lf
*.pro     text eol=lf
*.md     text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.json   text eol=lf
*.properties text eol=lf
*.sh     text eol=lf
*.sql    text eol=lf
*.toml   text eol=lf

# Windows-only scripts stay CRLF
*.bat    text eol=crlf
*.cmd    text eol=crlf
*.ps1    text eol=crlf

# Binary: no conversion of any kind
*.png    binary
*.jpg    binary
*.jpeg   binary
*.webp   binary
*.gif    binary
*.ico    binary
*.svg    text eol=lf
*.so     binary
*.aar    binary
*.jar    binary
*.zip    binary
*.gz     binary
*.jks    binary
*.keystore binary
*.bin    binary
*.ttf    binary
*.otf    binary
*.ttc    binary
