#!/usr/bin/env bash
# commit-msg hook: validates that commit messages follow Conventional Commits.
# If invalid, prints a hint and returns non-zero to block the commit; can be skipped with `git commit --no-verify`.
#
# Enable: run `git config core.hooksPath .githooks` from the repo root
# Disable: `git config --unset core.hooksPath`
#
# Format: <type>(<scope>): <subject>
#   <type>  ∈ feat fix refactor docs style chore ci build perf test
#   <scope> optional; recommended values are functional modules: agent settings terminal workspace git ui mcp db core docs build deps
#   <subject> a one-line summary, Chinese or English, no trailing period
#
# Multi-line commit messages: only the first line is validated (everything before the subject). Commits auto-generated by `git revert` / merge are skipped.

set -u

msg_file="$1"
first_line=$(sed -n '1p' "$msg_file")

# Skip auto-generated commits: merge / revert / fixup / squash / fixup records
case "$first_line" in
  "Merge "*|"Revert "*|"fixup!"*|"squash!"*) exit 0 ;;
esac

# Allowed types
types='feat|fix|refactor|docs|style|chore|ci|build|perf|test'

# Conventional Commits regex:
#   ^<type>(<scope>)?: <subject>   at least one non-whitespace character after the colon
pattern="^($types)(\([A-Za-z0-9._-]+\))?!?: .+"

if printf '%s' "$first_line" | LC_ALL=C grep -Eq "$pattern"; then
  exit 0
fi

# Invalid: print help and block
cat >&2 <<EOF

❌ The commit message does not follow the Conventional Commits spec:

   $first_line

Expected format:  <type>(<scope>): <subject>

Allowed types:
  feat      new feature
  fix       bug fix
  refactor  refactoring (no behavior change)
  docs      documentation
  style     formatting/whitespace (no logic changes)
  chore      housekeeping (build scripts, dependency versions, etc.)
  ci        CI configuration
  build      build system/dependencies
  perf      performance improvement
  test      tests

scope is optional; recommended values: agent settings terminal workspace git ui mcp db core deps

Examples:
  feat(agent): support streaming tool calls
  fix(settings): fix provider validation failure on save
  refactor: extract AILogger into core/util
  ci: remove the signature verification step

Skip validation (emergencies only): git commit --no-verify ...

EOF
exit 1
