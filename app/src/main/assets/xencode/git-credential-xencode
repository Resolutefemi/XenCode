#!/bin/sh
# Custom git credential helper: the unified credential entry point for local / remote.
#
# The credential source of truth is ~/.xencode/git-credentials; its content is "store plaintext, base64'd, then wholly reversed" —
# the file is not directly cat-able plaintext, which blocks casual cat, grep scanning, and AI ingestion into context.
# It is obfuscation, not encryption: reading this script can restore it; the goal is to raise the bar, not to resist attacks.
#
# This helper decodes it, matches by host, and outputs the KV pairs; on a miss:
#   local -> write cred-req-<id> for file IPC so the app pops a dialog to fill it in -> poll cred-resp-<id>;
#   remote (AICODE_CRED_NO_PROMPT non-empty, no app on the server) -> just exit empty.
#
# Bound via PRoot -b: /root/.xencode inside the container and filesDir/xencode on the host share the same inode,
# so the app-side FileObserver just watches for cred-req-* creation events in filesDir/xencode to trigger the dialog.
# HTTPS only: git invokes a credential helper's get only for http/https remotes; SSH goes through ssh-agent and never triggers this.
#
# The shebang is /bin/sh: PRoot Alpine always ships busybox ash, so this must run even when provisioning fails (no bash dependency).

op="$1"
# Only handle get; store/erase exit empty (persisting credentials is the app-side FileCredentialRepository's job).
[ "$op" = "get" ] || exit 0

# Read all KV pairs from stdin and grab host (git credential protocol fields are lowercased and normalized).
host=""
while IFS= read -r line; do
  case "$line" in
    host=*) host="${line#host=}" ;;
  esac
done
[ -n "$host" ] || exit 0

XENC_HOME="${XENCODE_DIR:-$HOME/.xencode}"
CREDS="$XENC_HOME/git-credentials"

# URL decode: %XX -> bytes (pure awk, busybox-awk compatible, no extra tools needed).
urldecode() {
  printf '%s' "$1" | awk '
  {
    out = ""
    for (i = 1; i <= length($0); i++) {
      c = substr($0, i, 1)
      if (c == "%" && i + 2 <= length($0)) {
        h = substr($0, i + 1, 2)
        d1 = index("0123456789abcdef", tolower(substr(h, 1, 1))) - 1
        d2 = index("0123456789abcdef", tolower(substr(h, 2, 1))) - 1
        if (d1 >= 0 && d2 >= 0) { out = out sprintf("%c", d1 * 16 + d2); i += 2; continue }
      }
      out = out c
    }
    printf "%s", out
  }'
}

# Decode the credential file: reverse the whole thing, then base64-decode; falls back level by level if the base64 command is missing.
decode_creds() {
  [ -f "$CREDS" ] || return 0
  raw="$(cat "$CREDS" 2>/dev/null)"
  [ -n "$raw" ] || return 0
  rev="$(printf '%s' "$raw" | awk '{ for (i = length($0); i > 0; i--) printf "%s", substr($0, i, 1) }')"
  printf '%s' "$rev" | base64 -d 2>/dev/null && return 0
  printf '%s' "$rev" | openssl base64 -d -A 2>/dev/null && return 0
  printf '%s' "$rev" | python3 -c 'import base64,sys;sys.stdout.buffer.write(base64.b64decode(sys.stdin.read()))' 2>/dev/null && return 0
  return 1
}

content="$(decode_creds)"
if [ -n "$content" ]; then
  # Exact @host suffix match so gist.github.com does not falsely match github.com (awk instead of grep in case the host contains regex metacharacters).
  line="$(printf '%s\n' "$content" | awk -v h="$host" 'substr($0, length($0) - length(h)) == "@" h { print; exit }')"
  if [ -n "$line" ]; then
    ut="${line#*://}"
    ut="${ut%@*}"
    printf 'username=%s\npassword=%s\n' "$(urldecode "${ut%%:*}")" "$(urldecode "${ut#*:}")"
    exit 0
  fi
fi

# Miss: no app on the remote to pop a dialog, just exit empty (git then reports an auth failure naturally).
[ -n "$AICODE_CRED_NO_PROMPT" ] && exit 0

# Miss (local) -> write the request file (atomic write: .tmp then mv, which triggers inotify and avoids the app reading a half-written file), then block polling for the response.
RID="$(date +%s)-$$"
REQ="$XENC_HOME/cred-req-$RID"
RESP="$XENC_HOME/cred-resp-$RID"
printf 'host=%s\n' "$host" > "$REQ.tmp"
mv "$REQ.tmp" "$REQ"

# Poll for the response (200ms). Hard cap ~25min (paired with the watchdog's 30min fallback); on timeout give up, delete the request, and exit non-zero.
i=0
while [ ! -f "$RESP" ]; do
  sleep 0.2
  i=$((i + 1))
  [ "$i" -gt 7500 ] && { rm -f "$REQ"; exit 1; }
done

# Response file content: plaintext KV username=...\npassword=... or cancel=1.
if grep -q '^cancel=1' "$RESP" 2>/dev/null; then
  rm -f "$REQ" "$RESP"
  exit 1   # User cancelled: exit non-zero so git reports an auth failure (same behavior as having no credentials).
fi

cat "$RESP"   # Feed the plaintext KV straight back to git (git handles percent-decoding or not by itself).
rm -f "$REQ" "$RESP"
