<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.XenCode" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/primary</item>
    </style>

    <!-- Theme dedicated to the built-in browser WebView: the WebView decides whether to report
         prefers-color-scheme to pages based on the theme's android:isLightTheme, while the App itself is a fixed Light theme + Compose-controlled colors; so a separate
         light/dark pair is provided for the WebView, picked by BrowserManager per the browser's dark-mode setting. -->
    <style name="Theme.XenCode.WebView" parent="Theme.XenCode">
        <item name="android:isLightTheme">true</item>
    </style>

    <style name="Theme.XenCode.WebView.Dark" parent="android:Theme.Material.NoActionBar">
        <item name="android:isLightTheme">false</item>
    </style>

    <!-- Cold-start splash theme: the app icon and surface background color serve as the system Window background, avoiding the harsh pure white on cold start -->
    <style name="Theme.XenCode.Splash" parent="Theme.XenCode">
        <item name="android:windowBackground">@drawable/splash_background</item>
    </style>

    <color name="primary">#007ACC</color>
    <color name="splash_background_color">#F9FAFA</color>
</resources>
