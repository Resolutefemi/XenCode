<?xml version="1.0" encoding="utf-8"?>
<!-- Used by sendFile file-card open-on-tap (ACTION_VIEW + FileProvider-granted URI).
     files-path covers filesDir/projects (the workspace root), filesDir/xencode (~/.xencode) and the rootfs;
     cache-path covers temporary caches downloaded via SFTP in remote mode and second copies of files that cannot be granted directly;
     external-path covers external local directory workspaces (directories on device storage). -->
<paths>
    <files-path name="files" path="." />
    <cache-path name="cache" path="." />
    <external-path name="external" path="." />
</paths>